<?xml version="1.0" encoding="utf-8"?>
<!-- geolocator_windows fetches CppWinRT through NuGet at build time; this
     supplies the source when a machine's own NuGet config has none. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
