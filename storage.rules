rules_version = '2';

// Image blobs for the media module. Objects are content-addressed under the
// owner's uid: users/{userId}/media/{contentHash}.
//
// Metadata (asset rows, references, embed tokens) travels through Firestore
// and is governed by firestore.rules; this file governs only the bytes.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/media/{contentHash} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Writes are additionally constrained to images under the same 10 MB
      // ceiling ingest enforces, so a compromised or buggy client cannot turn
      // the media prefix into general-purpose file hosting.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Anything outside a user's own media prefix is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
