rules_version = '2';

// Image blobs for the media module. Objects are content-addressed under the
// owner's uid: users/{userId}/media/{contentHash}.
//
// Metadata (asset rows, references, embed tokens) travels through Firestore
// and is governed by firestore.rules; this file governs only the bytes.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/media/{contentHash} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Writes are additionally constrained to images under the same 20 MB
      // ceiling ingest enforces, so a compromised or buggy client cannot turn
      // the media prefix into general-purpose file hosting.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Photo Series' encrypted images: users/{userId}/vault_media/{id} and
    // {id}.thumb, ciphertext only — see VaultBlob. Same size ceiling as
    // media. No content-type check: the app declares
    // application/octet-stream, but Storage sniffs the bytes and records
    // what it detects instead, and random ciphertext sometimes starts like
    // a JPEG, ZIP or audio frame — those uploads were refused for good
    // (BUG-294).
    match /users/{userId}/vault_media/{name} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 21 * 1024 * 1024;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Anything outside a user's own media prefixes is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
