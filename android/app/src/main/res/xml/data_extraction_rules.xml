<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31). Keeps automatic backups (files/backups/, see
     AUTO_BACKUP_HLD.md §8.2) out of Google Drive Auto Backup: seven archives
     would exceed its 25 MB quota, which stops backing up the app entirely,
     and would put an unmanaged second copy of the data in Drive. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
